# PPT Generator 환경변수 설정
# 이 파일을 복사하여 실제 값을 입력하세요.
# 사용법: source env/local.env && uv run ppt-generator

# ==============================================================================
# LLM 프로바이더 선택 (선택사항)
# ==============================================================================
# "anthropic" 또는 "bedrock" 중 선택. 미설정 시 auto-detect:
#   - ANTHROPIC_API_KEY가 설정되어 있으면 → anthropic
#   - 그 외 → bedrock
# LLM_PROVIDER=anthropic

# ==============================================================================
# Option 1: Anthropic API (직접)
# ==============================================================================
# https://console.anthropic.com/ 에서 API Key 발급
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ==============================================================================
# Option 2: AWS Bedrock
# ==============================================================================
# ~/.aws/credentials 파일이 설정되어 있으면 아래 변수는 불필요합니다.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
