# PPT Generator 선택 환경변수
# 사용법: source env/local.env && uv run ppt-generator
#
# 서버는 LLM을 직접 호출하지 않으므로 모델 공급자나 API 자격 증명이 필요하지 않습니다.

# Visual QA 스크린샷 병렬 워커 수
# VISUAL_QA_PARALLEL=8

# 클라이언트가 오케스트레이션하는 Visual QA 최대 반복 횟수
# VISUAL_QA_MAX_ITERATIONS=2

# 개별 스크린샷 캡처 제한 시간(초)
# SCREENSHOT_TIMEOUT=60

# 세션별 UUID 로그 파일 생성 디렉토리 (권장)
# PPT_LOG_DIR=/tmp/ppt-generator

# 단일 로그 파일 경로 (레거시, PPT_LOG_DIR 우선)
# PPT_LOG_FILE=/tmp/ppt-generator.log
